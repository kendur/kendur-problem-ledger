{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kendur/kendur-problem-ledger/schemas/problem-record.schema.json",
  "title": "KenDur Problem Ledger Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "visibility",
    "domains",
    "systems",
    "tags",
    "created",
    "updated",
    "summary",
    "symptoms",
    "investigation",
    "follow_up"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^KPL-[0-9]{4}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "triage",
        "investigating",
        "blocked",
        "monitoring",
        "resolved",
        "not-reproduced",
        "not-planned"
      ]
    },
    "visibility": {
      "const": "public"
    },
    "record_type": {
      "enum": [
        "incident",
        "question",
        "compatibility",
        "configuration",
        "design-decision",
        "experiment",
        "recurring-problem"
      ]
    },
    "severity": {
      "enum": ["informational", "low", "medium", "high", "critical"]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 80}
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 100}
    },
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "last_seen": {"type": ["string", "null"], "format": "date"},
    "recurrence_count": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"type": "string"},
        "reference": {"type": ["string", "null"]},
        "sanitized": {"const": true}
      },
      "required": ["platform", "sanitized"]
    },
    "summary": {"type": "string", "minLength": 20},
    "context": {"type": "string"},
    "expected_behavior": {"type": ["string", "null"]},
    "actual_behavior": {"type": ["string", "null"]},
    "symptoms": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "impact": {"type": ["string", "null"]},
    "environment": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": {"enum": ["observation", "log", "measurement", "image", "reference", "test-result"]},
          "description": {"type": "string"},
          "url": {"type": ["string", "null"], "format": "uri"}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis", "state"],
        "properties": {
          "hypothesis": {"type": "string"},
          "state": {"enum": ["untested", "supported", "rejected", "inconclusive"]},
          "basis": {"type": ["string", "null"]}
        }
      }
    },
    "investigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "action", "result"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "action": {"type": "string"},
          "result": {"type": "string"},
          "conclusion": {"type": ["string", "null"]}
        }
      }
    },
    "root_cause": {"type": ["string", "null"]},
    "workaround": {"type": ["string", "null"]},
    "resolution": {"type": ["string", "null"]},
    "validation": {"type": ["string", "null"]},
    "lessons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "related_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^KPL-[0-9]{4}-[0-9]{4}$"}
    },
    "duplicate_of": {
      "type": ["string", "null"],
      "pattern": "^KPL-[0-9]{4}-[0-9]{4}$"
    },
    "follow_up": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "status"],
        "properties": {
          "action": {"type": "string"},
          "status": {"enum": ["open", "blocked", "done", "not-needed"]},
          "due": {"type": ["string", "null"], "format": "date"}
        }
      }
    }
  }
}
